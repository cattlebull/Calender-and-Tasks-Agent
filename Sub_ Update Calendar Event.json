        "jsCode": "const input = $input.first().json;\nconst allItems = $input.all();\n\n// Get the original input passed to this sub-workflow\nconst triggerData = $('Execute Trigger').first().json;\n\nif (!allItems || allItems.length === 0 || !allItems[0].json.id) {\n  return [{ json: { error: true, output: `No event found matching \"${triggerData.search_query}\". Please check the event name.` } }];\n}\n\n// Pick the first match\nconst event = allItems[0].json;\nconst updates = {};\n\n// Only include fields the AI provided\nif (triggerData.new_title) updates.summary = triggerData.new_title;\nif (triggerData.new_start_datetime) updates.start = { dateTime: triggerData.new_start_datetime, timeZone: 'Asia/Kolkata' };\nif (triggerData.new_end_datetime) updates.end = { dateTime: triggerData.new_end_datetime, timeZone: 'Asia/Kolkata' };\nif (triggerData.new_description !== undefined) updates.description = triggerData.new_description;\n\nreturn [{ json: { eventId: event.id, updates, originalSummary: event.summary } }];"
      },
