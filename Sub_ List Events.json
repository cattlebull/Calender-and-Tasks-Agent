        "jsCode": "const events = $input.all();\nif (!events || events.length === 0 || !events[0].json.id) {\n  return [{ json: { output: 'You have no events scheduled for today.' } }];\n}\nconst lines = events.map(e => {\n  const start = e.json.start?.dateTime || e.json.start?.date || '';\n  const time = start.includes('T')\n    ? new Date(start).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata' })\n    : 'All day';\n  return `• ${e.json.summary || 'Untitled'} at ${time}`;\n});\nreturn [{ json: { output: \"Today's events:\\n\" + lines.join('\\n') } }];"
      },
